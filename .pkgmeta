package-as: SempreUI

manual-changelog: CHANGELOG.md

# Every module needs its own line here.
move-folders:
  SempreUI/Sempre: Sempre
  SempreUI/Sempre_Items: Sempre_Items
  SempreUI/Sempre_Ledger: Sempre_Ledger
  SempreUI/Sempre_Loot: Sempre_Loot
  SempreUI/Sempre_Mail: Sempre_Mail
  SempreUI/Sempre_Way: Sempre_Way

ignore:
  - README.md
  - CONTRIBUTING.md
  - CLAUDE.md
  - LICENSE
  - NAMING.md
  - .editorconfig
  - .github
  - .luacheckrc
  - tests
  - CHANGELOG.md
  - docs
